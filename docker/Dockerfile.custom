# ==============================================================================
# ReDroidCPP - Pure ReDroid Container Image
#
# Pure ReDroid container - NO QEMU/AVD dependencies
# Base image handles Android init automatically
#
# Requirements:
# - WSL2 with custom kernel (binder support)
# - /dev/binder accessible
# - Privileged container mode
# ==============================================================================

FROM redroid/redroid:12.0.0-latest

LABEL maintainer="ReDroidCPP"
LABEL version="3.0.0"
LABEL description="ReDroidCPP Android Container"

# Default environment
ENV REDROID_GPU_MODE=swiftshader
ENV REDROID_MEM_SIZE=1536M
ENV REDROID_RAM_SIZE=1536
ENV REDROID_NET_HOSTNAME=redroid-emulator
ENV ADB_PORT=5555

# ADB port
EXPOSE 5555

# Health check - Android boot completed
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=30 \
    CMD getprop sys.boot_completed 2>/dev/null | grep -q "1" || exit 1

# DO NOT override ENTRYPOINT
# redroid/redroid base image has its own /init that boots Android
# Overriding it (e.g. with tail -f /dev/null) prevents Android from starting
