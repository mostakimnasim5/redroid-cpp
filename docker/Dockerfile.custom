# ==============================================================================
# ReDroidCPP - Pure ReDroid Container Image
# 
# Pure ReDroid container - NO QEMU/AVD dependencies!
# This is a thin wrapper around the official ReDroid image.
# 
# Architecture:
# - Base: redroid/redroid (Android in Docker)
# - Size: ~500MB (vs ~8GB with QEMU/AVD)
# - Boot time: <3 seconds
# - RAM: ~1GB-1.5GB per instance
#
# Requirements:
# - KVM enabled host
# - /dev/kvm accessible
# - Privileged container mode
# ==============================================================================

FROM redroid/redroid:11.0.0-latest

# Metadata
LABEL maintainer="ReDroidCPP"
LABEL version="3.0.0"
LABEL description="ReDroidCPP - Pure ReDroid with Anti-Detection Modules"
LABEL architecture="pure-redroid"
LABEL no-qemu="true"

# Default configurations (override via docker-compose or environment)
ENV REDROID_GPU_MODE=swiftshader
ENV REDROID_MEM_SIZE=1536M
ENV REDROID_RAM_SIZE=1536
ENV REDROID_VGPU=auto
ENV REDROID_NET_HOSTNAME=redroid-emulator
ENV ADB_PORT=5555

# Expose ADB port
EXPOSE 5555

# Health check - wait for Android boot completion
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=20 \
    CMD getprop sys.boot_completed 2>/dev/null | grep -q "1" || exit 1

# Entrypoint - ReDroid handles its own startup, this just keeps container alive
ENTRYPOINT ["tail", "-f", "/dev/null"]

# ==============================================================================
# USAGE
# ==============================================================================
#
# Quick Start:
#   docker compose up -d
#   adb connect localhost:5555
#
# Custom Memory:
#   REDROID_MEM_SIZE=2048M docker compose up -d
#
# Hardware GPU:
#   REDROID_GPU_MODE=host docker compose up -d
#
# Device Spoofing: The C++ application applies all spoofing via ADB commands.
# No additional configuration needed in the container.
#
# ==============================================================================
