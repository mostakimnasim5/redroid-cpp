rules_version = '2';

// Firestore Security Rules for ReDroidCPP (project: redroid-d8110)
//
// ⚠️  WARNING — DEVELOPMENT MODE, OPEN ACCESS ⚠️
// The desktop app (redroid-cpp) calls Firestore REST with only a web API
// key, and the Mainadmin web panel signs in with Firebase Auth email/
// password but its Rules-evaluation context is still not role-scoped in
// code. Neither side enforces request.auth, so these rules must stay
// `if true` based until role-scoped access is implemented in BOTH
// codebases; otherwise calls would be rejected. Anyone holding the public
// client-side web API key can perform the operations below. Before going
// to production: implement role checks and replace these with auth-scoped
// rules.
//
// Permission matrix derived from FirestoreClient (src/GUI/FirebaseHelper.*)
// and Mainadmin admin.html:
//
//   accessRequests : create — LoginWindow submits a new login request
//                    get, list — admin panel fetches pending requests
//                    update — approve/reject (PATCH status/processedAt)
//
//   activeUsers    : create — admin panel creates a user (POST)
//                    get, list — app verifies login codes, panel lists users
//                    update — block/unblock, extend duration (PATCH)
//                    delete — admin panel removes a user (DELETE)
//
//   admins         : get, list — login/admin verification
//                    create, update, delete — Mainpanel sub-admin CRUD,
//                    needed because Auth email/password alone grants it
//
// Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    match /accessRequests/{doc} {
      allow create, get, list, update: if true;
      allow delete: if false;
    }

    match /activeUsers/{doc} {
      allow create, get, list, update, delete: if true;
    }

    match /admins/{doc} {
      allow get, list, create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
